# hf = local Qwen model, jev = hosted Jev (TypeSafe) API
JEV_BACKEND=hf
JEV_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# Set to false to skip the API key check on /api/v1/* (local development only).
JEV_AUTH_ENABLED=true

# Keys that clients must send as `X-API-Key` (comma-separated, >= 32 chars each).
# Required while JEV_AUTH_ENABLED=true.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JEV_CLIENT_API_KEYS=

# Only needed when JEV_BACKEND=jev (TYPESAFE_API_KEY is accepted too)
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_JEV_MODEL=jev-latest
JEV_JEV_TIMEOUT_S=30

JEV_EXPOSE_DOCS=true
JEV_LOG_LEVEL=INFO
JEV_HOST=127.0.0.1
JEV_PORT=8000
